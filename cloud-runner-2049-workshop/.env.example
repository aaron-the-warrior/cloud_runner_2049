# Credenciales del Modelo Gemini
# Obtén tu clave en https://aistudio.google.com/ o mediante Vertex AI en Google Cloud
GOOGLE_API_KEY=tu_gemini_api_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Configuración del modelo ADK (Gemini 4)
ADK_MODEL=gemini-4-argon

# Configuración de Google Cloud (Requerido si usas Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1

# Google Maps API y Remote MCP Server
# Para el laboratorio de Remote MCP (Google Maps MCP Server)
MAPS_API_KEY=tu_google_maps_api_key_aqui
MAPS_MCP_SERVER_URL=http://localhost:8000/sse

# Protocolo A2A (Agent-to-Agent)
A2A_PORT=8080
A2A_HOST=0.0.0.0
